rules_version = '2';

// City Ops OS — Firestore security rules.
//
// Not applied automatically: deploy with `firebase deploy --only firestore:rules`
// after creating your Firebase project (see DEPLOYMENT.md). Written and
// reviewed here, but not exercised against a live project in this session —
// there is no way to test Firestore rules without a real project.
//
// Role/foId live in a `users/{uid}` doc (see src/auth/firebaseAuth.ts),
// provisioned by you (Firebase console or the Admin SDK), never by the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isManager() {
      return isSignedIn() && myUser().role == "MANAGER";
    }
    function isFieldOfficer() {
      return isSignedIn() && myUser().role == "FIELD_OFFICER";
    }
    function myFoId() {
      return myUser().foId;
    }

    // Each user reads only their own account doc. Written by an admin only.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Manager: full access to every operational collection.
    match /{collection}/{docId} {
      allow read, write: if isManager();
    }

    // Field Officer: read what they need to do their assigned work; write
    // only records that are theirs. Rules are additive in Firestore — these
    // grant access in addition to (never instead of) the manager rule above.
    match /fos/{docId} {
      allow read: if isFieldOfficer();
    }
    match /businesses/{docId} {
      allow read: if isFieldOfficer();
    }
    match /rigs/{docId} {
      allow read: if isFieldOfficer();
    }
    match /assignments/{docId} {
      allow read: if isFieldOfficer() && resource.data.foId == myFoId();
      // Narrow update grant: the FO's own execution flow (arrival, en
      // route, session start/end, installation start — see
      // src/engine/workflows.ts's updateAssignment() calls) legitimately
      // needs to write these specific fields on an assignment that is
      // already theirs. Everything else on the document (foId, businessId,
      // rigId, plannedStart/plannedEnd, priority, reviewStatus, and any
      // other Manager-owned field) stays immutable from the FO side —
      // ownership can't change hands and no field outside this exact list
      // can be touched, even if the FO also happens to satisfy the foId
      // checks. Never a general write grant.
      //
      // affectedKeys() alone is NOT enough: it's the union of added,
      // changed, AND removed keys, so hasOnly([...]) on its own would also
      // permit deleteField() on any one of these fields — the FO's own
      // workflows never intend to delete any of them (every call site
      // always assigns a real value), so removedKeys().size() == 0
      // closes that off while still allowing a field to be set for the
      // FIRST time (an added key, not a removed one — the common case,
      // since these fields don't exist on the document until the FO's
      // first corresponding action).
      allow update: if isFieldOfficer()
        && resource.data.foId == myFoId()
        && request.resource.data.foId == myFoId()
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "enRouteAt",
          "actualArrivalAt",
          "actualStart",
          "actualEnd",
          "installationStartedAt",
          "sessionId",
          "status"
        ]);
    }
    match /sessions/{docId} {
      allow read: if isFieldOfficer() && resource.data.foId == myFoId();
      allow create, update: if isFieldOfficer() && request.resource.data.foId == myFoId();
    }
    match /issues/{docId} {
      allow read: if isFieldOfficer() && resource.data.foId == myFoId();
      allow create: if isFieldOfficer() && request.resource.data.foId == myFoId();
      // Limited resolve: an FO may only update an issue that is already
      // theirs, and only one with no rigId (rig issues stay on the repair
      // lifecycle regardless of who reported them — see permission matrix).
      allow update: if isFieldOfficer() && resource.data.foId == myFoId() && !("rigId" in resource.data);
    }
    match /rigIncidents/{docId} {
      allow read: if isFieldOfficer() && resource.data.foId == myFoId();
      allow create: if isFieldOfficer() && request.resource.data.foId == myFoId();
      // Narrow update grant: reportRigIncident() immediately follows its
      // own addRigIncident() with a linkedIssueId patch (see
      // src/engine/workflows.ts) — the FO created this incident and is
      // linking it to the companion Issue that same function created.
      // Every other field on the incident (category, severity, status,
      // description, foId, etc.) stays immutable from the FO side — the
      // repair lifecycle is Manager-owned from here on.
      //
      // removedKeys().size() == 0: same reasoning as assignments above —
      // affectedKeys().hasOnly(["linkedIssueId"]) alone would also permit
      // deleteField() on linkedIssueId, which no legitimate FO workflow
      // ever does (reportRigIncident() always sets it to a real id).
      allow update: if isFieldOfficer()
        && resource.data.foId == myFoId()
        && request.resource.data.foId == myFoId()
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["linkedIssueId"]);
    }
    match /activity/{docId} {
      allow read: if isFieldOfficer();
      allow create: if isFieldOfficer();
    }
    // Evidence is append-only from the FO's side: they can read and submit
    // their own records (including resubmissions after a recheck request —
    // always a new document, never an edit of the original), but only the
    // Manager may set status (approved/rejected/recheck_requested) — no FO
    // update or delete grant here, matching the append-only history design.
    match /evidence/{docId} {
      allow read: if isFieldOfficer() && resource.data.foId == myFoId();
      allow create: if isFieldOfficer() && request.resource.data.foId == myFoId();
    }
  }
}
