# City Ops OS — environment configuration
#
# Leave every VITE_FIREBASE_* variable unset (or delete this file entirely)
# to run in local DEMO MODE: all data stays in this browser's localStorage,
# the app makes zero external network requests, and Login offers two
# no-password demo identities (Manager / Field Officer).
#
# Set ALL of the variables below (all-or-nothing — the app checks that every
# one is present before it will talk to Firebase) to switch to a real,
# shared, multi-user backend. See DEPLOYMENT.md for how to create a free
# Firebase project and get these values from Project settings.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase Storage — binary evidence photos only. Firebase Auth and
# Firestore above remain the only auth/database. Both of the following are
# required for evidence photo upload/retry/review to work; leaving either
# unset means media upload silently no-ops (see data/mediaOutbox.ts), same
# "all required or none active" pattern as the Firebase vars above.
# See DEPLOYMENT.md for how to create the Supabase project, the PRIVATE
# `evidence` bucket, its RLS policies, and the public.managers table.
# NEVER put a Supabase service-role key here — this is a client-side,
# public anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
